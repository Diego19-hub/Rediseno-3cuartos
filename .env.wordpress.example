# Copiar a .env.wordpress y sustituir ambos secretos por valores locales únicos.
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=replace-with-local-secret
MARIADB_ROOT_PASSWORD=replace-with-local-root-secret
WORDPRESS_DB_HOST=mariadb:3306
# MariaDB consume los mismos valores; mantenerlos idénticos en .env.wordpress.
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=replace-with-local-secret
